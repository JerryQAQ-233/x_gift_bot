XGIFT_ORIGIN=https://xp.example.com
XGIFT_LISTEN=127.0.0.1:8787
XGIFT_DATA_DIR=/var/lib/xgift
XGIFT_PASSWORD_FILE=/etc/xgift/vault-password
XGIFT_ADMIN_PASSWORD_FILE=/etc/xgift/admin-password
XGIFT_PAYMENTS_ENABLED=false

# Configure both values to enable server-verified Turnstile on public submissions.
# Keep the secret in a private file, never in source control.
XGIFT_TURNSTILE_SITE_KEY=
XGIFT_TURNSTILE_SECRET_FILE=


# Optional GitHub identity gate for the public manual Stripe-link endpoint.
# Create a GitHub OAuth App with callback: https://YOUR_ORIGIN/auth/github/callback
XGIFT_GITHUB_AUTH_ENABLED=false
XGIFT_GITHUB_CLIENT_ID=
XGIFT_GITHUB_CLIENT_SECRET_FILE=/etc/xgift/github-client-secret

# All anti-abuse thresholds are configurable. 0 disables a numeric limit where noted.
XGIFT_GITHUB_MIN_ACCOUNT_AGE_DAYS=180
XGIFT_GITHUB_MAX_X_ACCOUNTS=3
XGIFT_GITHUB_ATTEMPT_WINDOW_HOURS=24
XGIFT_GITHUB_MAX_ATTEMPTS=5
XGIFT_GITHUB_COOLDOWN_MINUTES=30
XGIFT_GITHUB_MAX_CONCURRENT_QUEUE=1
XGIFT_GITHUB_SESSION_HOURS=168
